# Copy to .env (already .gitignore'd) and fill in real values.
# Never commit an actual .env file or paste real secrets into this one.

# development | staging | production
# production is intentionally refused by tools/install.php and bootstrap.php
# unless the database is already empty / properly migrated — see DEPLOY.md.
APP_ENV=development

# Full base URL of this store, no trailing slash.
# tools/install.php refuses to install onto elawaady.com or *.elawaady.com
# unless ELAWAADY_OWNER_DEPLOY_CONFIRM (below) is deliberately set by the
# person running the installer at the terminal.
APP_URL=http://localhost:8080

# --- Database (MySQL 8 / MariaDB 10.6+, mysqli) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=elawaady_store
DB_USER=root
DB_PASS=

# 64-char hex key used to encrypt SMM/API provider keys at rest (AES-256-GCM).
# Generate once and keep it — losing/rotating it makes stored provider keys
# unrecoverable. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
APP_ENCRYPTION_KEY=

# --- One-time, terminal-only override flags (never set these in a committed
#     file, CI job, or hosting panel default) ---

# Set to exactly "yes-deploy-elawaady-now" to allow tools/install.php to run
# with APP_URL pointing at elawaady.com. Leave unset in every normal case.
ELAWAADY_OWNER_DEPLOY_CONFIRM=

# --- Used only by tests/checkout_http_flow.sh style CLI test scripts, not by
#     the application itself. Safe to leave unset for a normal install. ---
CHECKOUT_HTTP_SERVICE_ID=
CHECKOUT_HTTP_USER_ID=
