APP_ENV=staging
HOST=0.0.0.0
PORT=8000

# Never commit real secrets. Configure these in Namecheap/cPanel environment variables.
SESSION_SECRET=replace_with_at_least_32_random_characters
ENCRYPTION_KEY=replace_with_at_least_32_random_characters

# Production/staging target: MySQL on Namecheap.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=elawhfwi_example_user
DB_PASSWORD=replace_me
DB_DATABASE=elawhfwi_example_db
DB_CHARSET=utf8mb4

# Allowed storefront/admin origins only.
CORS_ALLOWED_ORIGINS=https://e-network.net,https://www.e-network.net,https://elawaadyofficial.github.io

STORAGE_DRIVER=local
STORAGE_PATH=storage/uploads
