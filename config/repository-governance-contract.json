{
  "schema_version": 2,
  "branch": "chatgpt/store-build",
  "production_deploy_allowed": false,
  "runtime_authority": {
    "production_runtime": "php",
    "entrypoint": "index.php",
    "bootstrap_schema": "database.sql",
    "installer": "tools/install.php",
    "migration_runner": "migrate.php",
    "preflight": "tools/preflight.php",
    "migration_preflight": "tools/migration_preflight.php",
    "staging_rehearsal": "tools/staging_rehearsal.sh",
    "python_backend_reference_only": true
  },
  "branch_protection": {
    "ready": true,
    "mode": "ready_to_enable",
    "blockers": []
  },
  "required_checks": [
    {
      "workflow_file": ".github/workflows/backend-safety.yml",
      "workflow_name": "Backend production safety gate",
      "check_name": "safety"
    },
    {
      "workflow_file": ".github/workflows/storefront-safety.yml",
      "workflow_name": "Storefront Safety",
      "check_name": "PHP storefront syntax and staging preflight"
    },
    {
      "workflow_file": ".github/workflows/platform-integration.yml",
      "workflow_name": "Platform Integration",
      "check_name": "Authentication, dashboard, orders, suppliers and mediation"
    },
    {
      "workflow_file": ".github/workflows/staging-configuration-contract.yml",
      "workflow_name": "Staging Configuration Contract",
      "check_name": "validate-staging-configuration"
    }
  ],
  "rules": {
    "required_checks_must_exist": true,
    "workflow_names_must_match": true,
    "check_names_must_match_jobs": true,
    "validation_workflows_must_be_read_only": true,
    "live_deployment_must_remain_disabled": true,
    "branch_protection_readiness_must_match_workflows": true,
    "runtime_authority_must_match_repository": true
  }
}
